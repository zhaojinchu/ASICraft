#!/usr/bin/env bash
# Runs every acceptance check for every stage completed so far.
#   ./check            fast checks (no Minecraft server)
#   ./check --vanilla  also runs the checks that need the vanilla server
# A stage is done only when this passes. Checks are added before the code they test.

set -u
cd "$(dirname "$0")"

# Keep the Mac from idle-sleeping in the middle of a run (it stalls the server tests).
if [ -z "${REDFAB_CAFFEINATED:-}" ] && command -v caffeinate >/dev/null; then
    REDFAB_CAFFEINATED=1 exec caffeinate -i ./check "$@"
fi

ROOT=$PWD
source ./versions.env

export PATH="$HOME/.cargo/bin:$ROOT/.tools/jdk/Contents/Home/bin:$PATH"
export JAVA_HOME="$ROOT/.tools/jdk/Contents/Home"

VANILLA=0
for arg in "$@"; do
    case "$arg" in
        --vanilla) VANILLA=1 ;;
        *) echo "unknown argument: $arg" >&2; exit 2 ;;
    esac
done

mkdir -p build/check
FAILED=()
PASSED=0

# run <name> <command...>: runs the command, logs to build/check/<name>.log
run() {
    local name=$1; shift
    local log="build/check/$name.log"
    if "$@" >"$log" 2>&1; then
        printf '  PASS  %s\n' "$name"
        PASSED=$((PASSED + 1))
    else
        printf '  FAIL  %s   (see %s)\n' "$name" "$log"
        tail -n 15 "$log" | sed 's/^/        | /'
        FAILED+=("$name")
    fi
}

# ---------------------------------------------------------------- stage 0

pins_agree() {
    grep -q "\"@yowasp/yosys\": \"$YOWASP_NPM\"" package.json &&
    grep -q "yowasp-yosys==$YOWASP_PYPI" pyproject.toml &&
    cargo run -q -p redfab-cli -- --version | grep -q "(Minecraft $MC_VERSION, data version $MC_DATA_VERSION)" &&
    grep -q "\"mc_version\": \"$MC_VERSION\"" harness/data/block_defaults.json
}

tool_hashes() {
    [ "$(shasum -a 1 .tools/mc/server-$MC_VERSION.jar | cut -d' ' -f1)" = "$MC_SERVER_SHA1" ] &&
    java -version 2>&1 | grep -q 'version "25\.'
}

# The core must stay free of files, threads, clocks and subprocesses so it runs in a browser.
# crates/redfab-core/clippy.toml lists the banned APIs.
rust_lint() {
    cargo fmt --all --check &&
    cargo clippy --workspace --all-targets -- -D warnings
}

rust_wasm() {
    cargo build -p redfab-core --target wasm32-unknown-unknown
}

# read_slang must work in both WebAssembly builds of Yosys, and both must produce the same netlist.
yosys_py() {
    uv run --frozen python tools/yosys_py.py tests/smoke/nor2.sv nor2 build/check/nor2.py.json
}
yosys_node() {
    node tools/yosys_node.mjs tests/smoke/nor2.sv nor2 build/check/nor2.node.json
}
yosys_same() {
    uv run --frozen python tools/netlist_eq.py build/check/nor2.py.json build/check/nor2.node.json
}

# A file that only the slang frontend rejects correctly: if this "passes", read_slang is not really running.
yosys_negative() {
    printf 'module bad(input logic a, output logic y); assign y = a +; endmodule\n' > build/check/bad.sv
    ! uv run --frozen python tools/yosys_py.py build/check/bad.sv bad build/check/bad.json
}

verilator_smoke() {
    rm -rf build/check/vl &&
    verilator --binary --timing -Wall -Wno-fatal --Mdir build/check/vl \
        --top-module nor2_tb tests/smoke/nor2.sv tests/smoke/nor2_tb.sv &&
    build/check/vl/Vnor2_tb | grep -q '^PASS$'
}

server_smoke() {
    uv run --frozen python -m harness.smoke
}

echo "stage 0: setup"
run pins-agree        pins_agree
run tool-hashes       tool_hashes
run rust-lint         rust_lint
run rust-test         cargo test --workspace
run rust-wasm         rust_wasm
run yosys-slang-py    yosys_py
run yosys-slang-node  yosys_node
run yosys-same        yosys_same
run yosys-negative    yosys_negative
run verilator-smoke   verilator_smoke
if [ $VANILLA = 1 ]; then
    run server-smoke  server_smoke
fi

# ---------------------------------------------------------------- stage 1

# Every mechanics fixture, in both redstone modes, at three positions and two
# orientations: traces must equal the committed recordings and meet their
# expectations. The run also proves the idle-pause is off (it lasts > 65 s).
mechanics_verify() {
    uv run --frozen python -m harness.mechanics verify
}

# A deliberately wrong expectation must be reported as a failure.
mechanics_negative() {
    ! uv run --frozen python -m harness.mechanics verify --only torch_delay --break-expectation
}

echo "stage 1: vanilla harness"
run harness-unit        uv run --frozen pytest -q
if [ $VANILLA = 1 ]; then
    run mechanics-verify    mechanics_verify
    run mechanics-negative  mechanics_negative
fi

# ---------------------------------------------------------------- stage 2

REDFAB="cargo run -q -p redfab-cli --"

# The simulator must reproduce every recorded mechanics fixture tick for tick,
# block states and pending ticks, in both redstone modes.
sim_fixtures() {
    $REDFAB check-traces fixtures/mechanics
}

# ... and the committed corpus of random block arrangements (recorded from the game).
sim_corpus() {
    $REDFAB check-traces fixtures/fuzz
}

# Each deliberately wrong rule must make the corpus check fail.
sim_mutations() {
    for m in $($REDFAB list-mutations); do
        if $REDFAB check-traces --mutate "$m" fixtures/fuzz >/dev/null 2>&1 &&
           $REDFAB check-traces --mutate "$m" fixtures/fuzz-repeaters >/dev/null 2>&1 &&
           $REDFAB check-traces --mutate "$m" fixtures/mechanics >/dev/null 2>&1; then
            echo "mutation '$m' was NOT caught by either corpus or the mechanics fixtures"; return 1
        fi
        echo "mutation '$m' caught"
    done
}

# Structure files: written by the core, read back by the independent Python NBT reader.
nbt_roundtrip() {
    uv run --frozen python tools/nbt_roundtrip.py
}

# Fresh random arrangements recorded from the game and simulated; and structure files
# placed with /place template (strict and normal, including one larger than 48 blocks).
fuzz_vanilla() {
    uv run --frozen python -m harness.fuzz verify --count 40
}
place_template() {
    uv run --frozen python -m harness.place_template
}

echo "stage 2: simulator, part 1"
run sim-fixtures      sim_fixtures
run sim-corpus        sim_corpus
run sim-mutations     sim_mutations
run nbt-roundtrip     nbt_roundtrip
if [ $VANILLA = 1 ]; then
    run fuzz-vanilla      fuzz_vanilla
    run place-template    place_template
fi

# ---------------------------------------------------------------- stage 3

DESIGNS="not1 nor2 nor3"

# SystemVerilog to a baked block world: synthesis to the tile library's cells, a proof
# that the mapped netlist equals the source, placement, and the layout-versus-netlist
# check. Any of those failing fails the build.
build_designs() {
    for d in $DESIGNS; do
        $REDFAB build designs/$d/top.sv --top top -o build/designs/$d || return 1
    done
}

# The equivalence proof must be able to fail: swap the inverter for a buffer in a
# copy of the mapped netlist and the proof has to reject it.
equiv_negative() {
    rm -rf build/designs/_tampered && cp -r build/designs/not1 build/designs/_tampered &&
    grep -q "NOT " build/designs/_tampered/mapped.v &&
    sed -i '' 's/NOT /BUF /' build/designs/_tampered/mapped.v &&
    ! node synth/yosys.mjs build/designs/_tampered equiv.ys
}

# Every input combination: Verilator on the source vs the block simulator on the layout.
sim_vs_verilator() {
    uv run --frozen python -m harness.design sim $DESIGNS
}

# Broken copies of the layout (a cut wire, two wires shorted, a missing torch) must
# each be rejected by the layout-versus-netlist check.
lvs_negative() {
    uv run --frozen python -m harness.design lvs-negative nor2
}

# The WebAssembly build of the core must produce byte-identical output.
wasm_identical() {
    node tools/wasm_build_check.mjs $DESIGNS
}

# In the game, at three placements and in both redstone modes: outputs equal
# Verilator's for every input combination, the recorded traces equal the simulator's,
# a strictly placed build does not move, and a normally placed one settles the same.
design_vanilla() {
    uv run --frozen python -m harness.design vanilla $DESIGNS
}

# Broken copies must fail the function check in the game.
design_negative_vanilla() {
    uv run --frozen python -m harness.design vanilla-negative nor2
}

# With time running normally (no freezing or stepping), as a player would see it.
design_live() {
    uv run --frozen python -m harness.show nor2 --self-test
}

echo "stage 3: first circuit"
run build-designs       build_designs
run equiv-negative      equiv_negative
run sim-vs-verilator    sim_vs_verilator
run lvs-negative        lvs_negative
run wasm-identical      wasm_identical
if [ $VANILLA = 1 ]; then
    run design-vanilla           design_vanilla
    run design-negative-vanilla  design_negative_vanilla
    run design-live              design_live
fi

# ---------------------------------------------------------------- stage 4

# With repeaters in the simulator, every mechanics recording must replay; none may be
# skipped for using a block the simulator lacks.
sim_fixtures_complete() {
    $REDFAB check-traces --no-skips fixtures/mechanics
}

# A second corpus of random circuits, this one with repeaters and repeater locks.
sim_corpus_repeaters() {
    $REDFAB check-traces --no-skips fixtures/fuzz-repeaters
}

echo "stage 4: simulator, part 2"
run sim-fixtures-complete   sim_fixtures_complete
run sim-corpus-repeaters    sim_corpus_repeaters

# ---------------------------------------------------------------- stage 5

# The tile contract, checked statically for every pair of tile variants side by side
# and for random 2x2 groups: the circuit read back from the blocks must connect the
# two tiles only through matched ports. (Reads the blocks with the simulator's rules,
# which stages 2 and 4 checked against the game.)
tile_adjacency() {
    $REDFAB tile-adjacency
}

# Every tile variant gets a fixture: drivers and readers on its ports, and
# expectations from its description (truth table, delay). Here they are generated and
# replayed in the simulator; the vanilla check runs them in the game.
tile_fixtures() {
    rm -rf build/tiles && $REDFAB tile-fixtures build/tiles && $REDFAB check-fixtures build/tiles
}

# In the game, at three placements and in both modes: every tile variant meets its
# expectations, and the recorded traces equal the simulator's. Plus a random sample of
# tile pairs and 2x2 groups, replayed in the simulator.
tiles_vanilla() {
    uv run --frozen python -m harness.tiles verify
}

echo "stage 5: tile set"
run tile-adjacency      tile_adjacency
run tile-fixtures       tile_fixtures
if [ $VANILLA = 1 ]; then
    run tiles-vanilla       tiles_vanilla
fi

# ---------------------------------------------------------------- summary

echo
if [ ${#FAILED[@]} -eq 0 ]; then
    echo "all $PASSED checks passed"
    [ $VANILLA = 1 ] || echo "(vanilla-server checks skipped; run ./check --vanilla)"
else
    echo "${#FAILED[@]} failed: ${FAILED[*]}"
    exit 1
fi
