#!/usr/bin/env bash
# Runs every acceptance check for every stage completed so far.
#   ./check            fast checks (no Minecraft server)
#   ./check --vanilla  also runs the checks that need the vanilla server
# A stage is done only when this passes. Checks are added before the code they test.

set -u
cd "$(dirname "$0")"

# Keep the Mac from idle-sleeping in the middle of a run (it stalls the server tests).
if [ -z "${REDFAB_CAFFEINATED:-}" ] && command -v caffeinate >/dev/null; then
    REDFAB_CAFFEINATED=1 exec caffeinate -i ./check "$@"
fi

ROOT=$PWD
source ./versions.env

export PATH="$HOME/.cargo/bin:$ROOT/.tools/jdk/Contents/Home/bin:$PATH"
export JAVA_HOME="$ROOT/.tools/jdk/Contents/Home"

VANILLA=0
for arg in "$@"; do
    case "$arg" in
        --vanilla) VANILLA=1 ;;
        *) echo "unknown argument: $arg" >&2; exit 2 ;;
    esac
done

mkdir -p build/check
FAILED=()
PASSED=0

# run <name> <command...>: runs the command, logs to build/check/<name>.log
run() {
    local name=$1; shift
    local log="build/check/$name.log"
    if "$@" >"$log" 2>&1; then
        printf '  PASS  %s\n' "$name"
        PASSED=$((PASSED + 1))
    else
        printf '  FAIL  %s   (see %s)\n' "$name" "$log"
        tail -n 15 "$log" | sed 's/^/        | /'
        FAILED+=("$name")
    fi
}

# ---------------------------------------------------------------- stage 0

pins_agree() {
    grep -q "\"@yowasp/yosys\": \"$YOWASP_NPM\"" package.json &&
    grep -q "yowasp-yosys==$YOWASP_PYPI" pyproject.toml &&
    cargo run -q -p redfab-cli -- --version | grep -q "(Minecraft $MC_VERSION, data version $MC_DATA_VERSION)" &&
    grep -q "\"mc_version\": \"$MC_VERSION\"" harness/data/block_defaults.json
}

tool_hashes() {
    [ "$(shasum -a 1 .tools/mc/server-$MC_VERSION.jar | cut -d' ' -f1)" = "$MC_SERVER_SHA1" ] &&
    java -version 2>&1 | grep -q 'version "25\.'
}

# The core must stay free of files, threads, clocks and subprocesses so it runs in a browser.
# crates/redfab-core/clippy.toml lists the banned APIs.
rust_lint() {
    cargo fmt --all --check &&
    cargo clippy --workspace --all-targets -- -D warnings
}

rust_wasm() {
    cargo build -p redfab-core --target wasm32-unknown-unknown
}

# read_slang must work in both WebAssembly builds of Yosys, and both must produce the same netlist.
yosys_py() {
    uv run --frozen python tools/yosys_py.py tests/smoke/nor2.sv nor2 build/check/nor2.py.json
}
yosys_node() {
    node tools/yosys_node.mjs tests/smoke/nor2.sv nor2 build/check/nor2.node.json
}
yosys_same() {
    uv run --frozen python tools/netlist_eq.py build/check/nor2.py.json build/check/nor2.node.json
}

# A file that only the slang frontend rejects correctly: if this "passes", read_slang is not really running.
yosys_negative() {
    printf 'module bad(input logic a, output logic y); assign y = a +; endmodule\n' > build/check/bad.sv
    ! uv run --frozen python tools/yosys_py.py build/check/bad.sv bad build/check/bad.json
}

verilator_smoke() {
    rm -rf build/check/vl &&
    verilator --binary --timing -Wall -Wno-fatal --Mdir build/check/vl \
        --top-module nor2_tb tests/smoke/nor2.sv tests/smoke/nor2_tb.sv &&
    build/check/vl/Vnor2_tb | grep -q '^PASS$'
}

server_smoke() {
    uv run --frozen python -m harness.smoke
}

echo "stage 0: setup"
run pins-agree        pins_agree
run tool-hashes       tool_hashes
run rust-lint         rust_lint
run rust-test         cargo test --workspace
run rust-wasm         rust_wasm
run yosys-slang-py    yosys_py
run yosys-slang-node  yosys_node
run yosys-same        yosys_same
run yosys-negative    yosys_negative
run verilator-smoke   verilator_smoke
if [ $VANILLA = 1 ]; then
    run server-smoke  server_smoke
fi

# ---------------------------------------------------------------- stage 1

# Every mechanics fixture, in both redstone modes, at three positions and two
# orientations: traces must equal the committed recordings and meet their
# expectations. The run also proves the idle-pause is off (it lasts > 65 s).
mechanics_verify() {
    uv run --frozen python -m harness.mechanics verify
}

# A deliberately wrong expectation must be reported as a failure.
mechanics_negative() {
    ! uv run --frozen python -m harness.mechanics verify --only torch_delay --break-expectation
}

echo "stage 1: vanilla harness"
run harness-unit        uv run --frozen pytest -q
if [ $VANILLA = 1 ]; then
    run mechanics-verify    mechanics_verify
    run mechanics-negative  mechanics_negative
fi

# ---------------------------------------------------------------- stage 2

REDFAB="cargo run -q -p redfab-cli --"

# The simulator must reproduce every recorded mechanics fixture tick for tick,
# block states and pending ticks, in both redstone modes.
sim_fixtures() {
    $REDFAB check-traces fixtures/mechanics
}

# ... and the committed corpus of random block arrangements (recorded from the game).
sim_corpus() {
    $REDFAB check-traces fixtures/fuzz
}

# Each deliberately wrong rule must make the corpus check fail.
sim_mutations() {
    for m in $($REDFAB list-mutations); do
        if $REDFAB check-traces --mutate "$m" fixtures/fuzz >/dev/null 2>&1 &&
           $REDFAB check-traces --mutate "$m" fixtures/fuzz-repeaters >/dev/null 2>&1 &&
           $REDFAB check-traces --mutate "$m" fixtures/mechanics >/dev/null 2>&1; then
            echo "mutation '$m' was NOT caught by either corpus or the mechanics fixtures"; return 1
        fi
        echo "mutation '$m' caught"
    done
}

# Structure files: written by the core, read back by the independent Python NBT reader.
nbt_roundtrip() {
    uv run --frozen python tools/nbt_roundtrip.py
}

# Fresh random arrangements recorded from the game and simulated; and structure files
# placed with /place template (strict and normal, including one larger than 48 blocks).
fuzz_vanilla() {
    uv run --frozen python -m harness.fuzz verify --count 40
}
place_template() {
    uv run --frozen python -m harness.place_template
}

echo "stage 2: simulator, part 1"
run sim-fixtures      sim_fixtures
run sim-corpus        sim_corpus
run sim-mutations     sim_mutations
run nbt-roundtrip     nbt_roundtrip
if [ $VANILLA = 1 ]; then
    run fuzz-vanilla      fuzz_vanilla
    run place-template    place_template
fi

# ---------------------------------------------------------------- stage 3

DESIGNS="not1 nor2 nor3 consts fa1 adder4"

# SystemVerilog to a baked block world: synthesis to the tile library's cells, a proof
# that the mapped netlist equals the source, placement, and the layout-versus-netlist
# check. Any of those failing fails the build.
build_designs() {
    for d in $DESIGNS; do
        $REDFAB build designs/$d/top.sv --top top -o build/designs/$d || return 1
    done
}

# The equivalence proof must be able to fail: swap the inverter for a buffer in a
# copy of the mapped netlist and the proof has to reject it.
equiv_negative() {
    rm -rf build/designs/_tampered && cp -r build/designs/not1 build/designs/_tampered &&
    grep -q "NOT " build/designs/_tampered/mapped.v &&
    sed -i '' 's/NOT /BUF /' build/designs/_tampered/mapped.v &&
    ! node synth/yosys.mjs build/designs/_tampered equiv.ys
}

# Every input combination: Verilator on the source vs the block simulator on the layout
# (512 combinations for the 4-bit adder).
sim_vs_verilator() {
    uv run --frozen python -m harness.design sim $DESIGNS
}

# Broken copies of the layout (a cut wire, two wires shorted, a missing torch) must
# each be rejected by the layout-versus-netlist check.
lvs_negative() {
    uv run --frozen python -m harness.design lvs-negative nor2
}

# The WebAssembly build of the core must produce byte-identical output.
wasm_identical() {
    node tools/wasm_build_check.mjs $DESIGNS
}

# In the game, at three placements and in both redstone modes: outputs equal
# Verilator's (every input combination up to 32, a sample beyond that), the recorded
# traces equal the simulator's, a strictly placed build does not move, and a normally
# placed one settles the same.
design_vanilla() {
    uv run --frozen python -m harness.design vanilla $DESIGNS
}

# Broken copies must fail the function check in the game.
design_negative_vanilla() {
    uv run --frozen python -m harness.design vanilla-negative nor2
}

# With time running normally (no freezing or stepping), as a player would see it.
design_live() {
    uv run --frozen python -m harness.show nor2 --self-test
}

echo "stage 3: first circuit"
run build-designs       build_designs
run equiv-negative      equiv_negative
run sim-vs-verilator    sim_vs_verilator
run lvs-negative        lvs_negative
run wasm-identical      wasm_identical
if [ $VANILLA = 1 ]; then
    run design-vanilla           design_vanilla
    run design-negative-vanilla  design_negative_vanilla
    run design-live              design_live
fi

# ---------------------------------------------------------------- stage 4

# With repeaters in the simulator, every mechanics recording must replay; none may be
# skipped for using a block the simulator lacks.
sim_fixtures_complete() {
    $REDFAB check-traces --no-skips fixtures/mechanics
}

# A second corpus of random circuits, this one with repeaters and repeater locks.
sim_corpus_repeaters() {
    $REDFAB check-traces --no-skips fixtures/fuzz-repeaters
}

echo "stage 4: simulator, part 2"
run sim-fixtures-complete   sim_fixtures_complete
run sim-corpus-repeaters    sim_corpus_repeaters

# ---------------------------------------------------------------- stage 5

# The tile contract, checked statically for every pair of tile variants side by side
# and for random 2x2 groups: the circuit read back from the blocks must connect the
# two tiles only through matched ports. (Reads the blocks with the simulator's rules,
# which stages 2 and 4 checked against the game.)
tile_adjacency() {
    $REDFAB tile-adjacency
}

# Every tile variant gets a fixture: drivers and readers on its ports, and
# expectations from its description (truth table, delay). Here they are generated and
# replayed in the simulator; the vanilla check runs them in the game.
tile_fixtures() {
    rm -rf build/tiles && $REDFAB tile-fixtures build/tiles && $REDFAB check-fixtures build/tiles
}

# In the game, at three placements and in both modes: every tile variant meets its
# expectations, and the recorded traces equal the simulator's. Plus a random sample of
# tile pairs and 2x2 groups, replayed in the simulator.
tiles_vanilla() {
    uv run --frozen python -m harness.tiles verify
}

echo "stage 5: tile set"
run tile-adjacency      tile_adjacency
run tile-fixtures       tile_fixtures
if [ $VANILLA = 1 ]; then
    run tiles-vanilla       tiles_vanilla
fi

# ---------------------------------------------------------------- stage 6

# Random combinational netlists (NOT/NOR2/NOR3 with constants and fan-out) must
# always place, route and pass the layout-versus-netlist and signal-strength checks.
pnr_random() {
    $REDFAB pnr-random --count 60 --seed 1
}

# The 4-bit adder on every one of its 512 input combinations in the game, in both
# redstone modes (outputs only, sampled after each combination settles).
design_exhaustive_vanilla() {
    uv run --frozen python -m harness.design exhaustive adder4
}

echo "stage 6: placement and routing"
run pnr-random          pnr_random
if [ $VANILLA = 1 ]; then
    run adder4-exhaustive   design_exhaustive_vanilla
fi

# ---------------------------------------------------------------- stage 7

# The timing report must be tight. On every design, the simulator applies every
# single-bit input flip from every input combination and a sample of multi-bit
# changes, and watches each lamp: the latest change observed for an output must equal
# its reported worst case, and nothing may change earlier than its reported best case.
timing_tight() {
    for d in $DESIGNS; do
        $REDFAB timing-measure build/designs/$d/design.json || return 1
    done
}

# Building the same source twice must give byte-identical output.
build_deterministic() {
    rm -rf build/again &&
    $REDFAB build designs/adder4/top.sv --top top -o build/again/adder4 >/dev/null &&
    cmp build/designs/adder4/mapped.json build/again/adder4/mapped.json &&
    cmp build/designs/adder4/design.json build/again/adder4/design.json &&
    cmp build/designs/adder4/world.nbt build/again/adder4/world.nbt &&
    echo "adder4 builds the same twice"
}

# In the game (from the traces recorded by design-vanilla above): after every input
# change, no lamp changes later than its reported worst case, and the worst case is
# reached by at least one of the recorded changes of the full adder.
timing_traces() {
    uv run --frozen python -m harness.design timing-traces $DESIGNS
}

echo "stage 7: timing analysis"
run timing-tight        timing_tight
run build-deterministic build_deterministic
if [ $VANILLA = 1 ]; then
    run timing-traces       timing_traces
fi

# ---------------------------------------------------------------- stage 8

# Each flip-flop candidate has sweep fixtures among the tile fixtures: the data edge
# moved one tick at a time against the clock edge, at several clock pulse widths, with
# the clock also pulsed too briefly. The game runs them with the other tile fixtures
# (tiles-vanilla), and their traces must equal the simulator's. Here, the table each
# sweep gives in the simulator is turned into setup, hold, clock-to-output and
# minimum pulse width, which must be what the tile's description says.
dff_characterized() {
    $REDFAB characterize build/tiles
}

# The chosen flip-flop must not depend on same-tick ordering: its sweep table is the
# same under shuffled tick and update orders, and the capture window keeps at least one
# redstone tick (2 game ticks) of margin from any same-tick coincidence.
dff_margin() {
    $REDFAB characterize build/tiles --shuffles 20 --margin 2 --chosen dff
}

echo "stage 8: flip-flop characterization"
run dff-characterized   dff_characterized
run dff-margin          dff_margin

# ---------------------------------------------------------------- stage 9

CLOCKED="counter4 fsm shift2"

# Clocked designs build like the others: flip-flops mapped in synthesis, the
# sequential proof, a register column, hold and skew analysis with repeater delays
# raised where a path is too short, and the burnout budget. The report states the
# shortest clock period.
build_clocked() {
    for d in $CLOCKED; do
        $REDFAB build designs/$d/top.sv --top top -o build/designs/$d || return 1
    done
}

# For 64 clock cycles of random inputs at the reported period: the block simulator's
# outputs equal Verilator's every cycle, and stay equal when the ticks that fall due
# together are run in shuffled orders.
cycles_sim() {
    uv run --frozen python -m harness.design cycles $CLOCKED
}

# A copy of the shift register with a clock repeater slowed so that the second
# flip-flop's clock arrives late must be flagged for a hold violation ...
hold_negative() {
    uv run --frozen python -m harness.design hold-negative shift2
}

# ... and the burnout budget: every design reports the fewest ticks between input
# changes at which no torch turns off more than six times within sixty ticks (the
# game burns one out on the eighth). Driving the inverter twice as fast as its report
# allows must be flagged by the tool, and must burn its torch out in the simulator.
burnout_negative() {
    uv run --frozen python -m harness.design burnout-negative not1
}

# In the game, at three placements and in both modes: 64 cycles of the counter and
# the state machine equal Verilator; the hold-broken shift register fails; the
# inverter driven faster than its budget burns out.
cycles_vanilla() {
    uv run --frozen python -m harness.design cycles-vanilla counter4 fsm
}
negatives_vanilla() {
    uv run --frozen python -m harness.design hold-negative-vanilla shift2 &&
    uv run --frozen python -m harness.design burnout-negative-vanilla not1
}

echo "stage 9: counter and state machine"
run build-clocked       build_clocked
run cycles-sim          cycles_sim
run hold-negative       hold_negative
run burnout-negative    burnout_negative
if [ $VANILLA = 1 ]; then
    run cycles-vanilla      cycles_vanilla
    run negatives-vanilla   negatives_vanilla
fi

# ---------------------------------------------------------------- stage 10

# The playground's compile pipeline under Node, without a browser: the same YoWASP
# Yosys and the same WebAssembly core the page uses turn each design's source into
# the same design file the native build wrote; the in-browser simulator's trace of a
# stimulus equals the native simulator's; and the limits hold: a source too large, a
# design too large, and one that never finishes synthesizing are all refused within
# the time limit, with a message, and the worker is usable afterwards.
playground_pipeline() {
    node --test tools/playground_test.mjs
}

# The page itself, in a headless Chromium (Brave): it types each design's source into
# the editor, compiles, toggles the input levers by clicking them in the 3D view and
# through the panel, reads the lamps, and they match the native simulator. It saves
# a screenshot to build/playground/ to look at.
playground_headless() {
    node tools/playground_check.mjs
}

echo "stage 10: browser playground"
run playground-pipeline playground_pipeline
run playground-headless playground_headless

# ---------------------------------------------------------------- stage 11

# The observer mod (mod/) compiles against the server, Fabric Loader and Mixin with
# javac alone: Minecraft 26.3 ships unobfuscated.
mod_builds() {
    tools/build_mod.sh
}

# On the Fabric server with the mod: every mechanics recording from stage 1 replays
# exactly, in both modes and at three placements (the mod changes nothing), and the
# mod's stream agrees with every snapshot read from disk, tick for tick.
mechanics_modded() {
    uv run --frozen python -m harness.mechanics verify --modded
}

echo "stage 11: server mod and live stream"
run mod-builds          mod_builds
if [ $VANILLA = 1 ]; then
    run mechanics-modded    mechanics_modded
fi

# ---------------------------------------------------------------- stage 12

# The live playground's backend under Node, with a fake world standing in for the
# game: submissions are compiled in a sandboxed child process (killed at the time
# and memory limits), placed as the native build in a free plot, and driven by
# levers that reach only their probe blocks; the stream reaches viewers filtered
# to their plot; the recording of what the stream said equals the simulator's
# trace when the simulator plays the game, and replays natively; a design too big
# for a plot, an unexpected field, a hostile source and bad lever messages are all
# refused; plots are limited, released and cleared.
live_test() {
    node --test tools/live_test.mjs
}

# On the real modded server, in a headless browser: an inverter driven through the
# API and the counter driven through the page both record traces that replay
# natively tick for tick; the page shows what the server shows; with a counter
# running in every plot the server's tick time stays within budget.
live_check() {
    node tools/live_check.mjs
}

echo "stage 12: live playground"
run live-test          live_test
if [ $VANILLA = 1 ]; then
    run live-vanilla       live_check
fi

# ---------------------------------------------------------------- summary

echo
if [ ${#FAILED[@]} -eq 0 ]; then
    echo "all $PASSED checks passed"
    [ $VANILLA = 1 ] || echo "(vanilla-server checks skipped; run ./check --vanilla)"
else
    echo "${#FAILED[@]} failed: ${FAILED[*]}"
    exit 1
fi
