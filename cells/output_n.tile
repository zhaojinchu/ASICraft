# The output tile three blocks wide, for a row a cell deep (see output): the
# port's dust and the lamp it points into.
tile output_n
size 3 4 5
port W in 0 1 2
lamp 1 1 2

legend
  G minecraft:glass
  L minecraft:redstone_lamp
  - minecraft:redstone_wire

layer 0
  ...
  ...
  G..
  ...
  ...
layer 1
  ...
  ...
  -L.
  ...
  ...
