# The input tile three blocks wide, for a row a cell deep (see input): the
# probe block with its lever, off the border, and the port's dust. The signal
# leaves at full strength.
tile input_n
size 3 4 5
port E out 2 1 2
probe 1 1 2

legend
  G minecraft:glass
  # minecraft:stone
  / minecraft:lever[face=floor,facing=east,powered=false]
  - minecraft:redstone_wire if E

layer 0
  ...
  ...
  ..G
  ...
  ...
layer 1
  ...
  ...
  .#-
  ...
  ...
layer 2
