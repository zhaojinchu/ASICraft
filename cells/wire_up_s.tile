# The upper wire for a row three blocks deep: the shallow wire's dust lifted to
# y = 3, each dust on a stone at y = 2 (see wire_up).
tile wire_up_s
size 5 4 3
port W io 0 3 1
port E io 4 3 1
port N io 2 3 0
port S io 2 3 2

legend
  C minecraft:stone
  c minecraft:redstone_wire
  W minecraft:stone if W
  w minecraft:redstone_wire if W
  E minecraft:stone if E
  e minecraft:redstone_wire if E
  N minecraft:stone if N
  n minecraft:redstone_wire if N
  S minecraft:stone if S
  s minecraft:redstone_wire if S

layer 2
  ..N..
  WWCEE
  ..S..
layer 3
  ..n..
  wwcee
  ..s..
