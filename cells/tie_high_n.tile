# Constant 1 three blocks wide, for a row a cell deep (see tie_high): the
# torch, off the border, and the port's dust.
tile tie_high_n
size 3 4 5
port E out 2 1 2
function high

legend
  G minecraft:glass
  T minecraft:redstone_torch
  - minecraft:redstone_wire

layer 0
  ...
  ...
  .GG
  ...
  ...
layer 1
  ...
  ...
  .T-
  ...
  ...
