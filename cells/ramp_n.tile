# The ramp for a routing column three blocks wide, west to east: the lower
# west port, one dust on a stone step at y = 2, the upper east port on a stone,
# three blocks in all (see ramp). Turned half round it runs east to west.
tile ramp_n
size 3 4 5
port W io 0 1 2
port E io 2 3 2

legend
  G minecraft:glass
  # minecraft:stone
  - minecraft:redstone_wire

