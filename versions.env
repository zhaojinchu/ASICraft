# Pinned external tools. `tools/setup.sh` installs exactly these; `./check` verifies the hashes.
# Bump deliberately: after changing MC_*, regenerate the vanilla trace fixtures.

MC_VERSION=26.3
MC_DATA_VERSION=5023
MC_SERVER_URL=https://piston-data.mojang.com/v1/objects/33680f5f2ac32864d6d7cf5e56a705fdb3e05f4c/server.jar
MC_SERVER_SHA1=33680f5f2ac32864d6d7cf5e56a705fdb3e05f4c

# Fabric Loader for the server mod (stage 11): the server launcher jar, which installs the
# loader and Mixin into .tools/fabric on first run. Minecraft 26.3 ships unobfuscated, so
# the mod compiles straight against the server jar.
FABRIC_LOADER_VERSION=0.19.5
FABRIC_INSTALLER_VERSION=1.1.2
FABRIC_LAUNCHER_URL=https://meta.fabricmc.net/v2/versions/loader/26.3/0.19.5/1.1.2/server/jar
FABRIC_LAUNCHER_SHA256=0b56ad54d762172e8b8748e467f584f071e4dedecd93dc336cf2c68837e790be
MIXIN_VERSION=0.17.4+mixin.0.8.7

JDK_VERSION=25.0.4.1+1
JDK_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jdk_aarch64_mac_hotspot_25.0.4.1_1.tar.gz
JDK_SHA256=61979887f7506a24a57439ff99adb8b3a7fc89977d9cfe3b8984f58a981b7b9d

# Yosys 0.68 compiled to WebAssembly. The same release is used natively (PyPI) and in the browser (npm).
# The versions are also pinned in pyproject.toml and package.json; `./check` asserts they agree.
YOWASP_PYPI=0.68.0.0.post1208
YOWASP_NPM=0.68.1207
