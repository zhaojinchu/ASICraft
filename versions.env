# Pinned external tools. `tools/setup.sh` installs exactly these. `./check` (stage 0) verifies
# the server jar's SHA1, the Fabric launcher's and libraries' SHA256, the JDK, Node, Verilator
# and YoWASP versions, and that every committed game recording was made with this server jar.
# Python is pinned in .python-version (uv reads that file); ./check asserts the interpreter.
# Bump deliberately: after changing MC_*, regenerate the vanilla trace fixtures.

MC_VERSION=26.3
MC_DATA_VERSION=5023
MC_SERVER_URL=https://piston-data.mojang.com/v1/objects/33680f5f2ac32864d6d7cf5e56a705fdb3e05f4c/server.jar
MC_SERVER_SHA1=33680f5f2ac32864d6d7cf5e56a705fdb3e05f4c

# Fabric Loader for the server mod (stage 11): the server launcher jar, which installs the
# loader and Mixin into .tools/fabric on first run. Minecraft 26.3 ships unobfuscated, so
# the mod compiles straight against the server jar.
FABRIC_LOADER_VERSION=0.19.5
FABRIC_INSTALLER_VERSION=1.1.2
FABRIC_LAUNCHER_URL=https://meta.fabricmc.net/v2/versions/loader/26.3/0.19.5/1.1.2/server/jar
FABRIC_LAUNCHER_SHA256=0b56ad54d762172e8b8748e467f584f071e4dedecd93dc336cf2c68837e790be
MIXIN_VERSION=0.17.4+mixin.0.8.7
# The libraries the launcher fetches from Maven on that first run (.tools/fabric/libraries,
# 46 jars): the SHA256 of the sorted list of their SHA256s, as setup.sh and ./check compute
# it (`find libraries -type f | sort | xargs shasum -a 256 | shasum -a 256`).
FABRIC_LIBRARIES_SHA256=c6b9b22b7baf9ff96699905708bdeca2ce5b18a70318d85abcd8f56b7809235e

# Temurin JDK 25, one tarball per platform (`uname -sm`). setup.sh picks the one for this
# machine and links .tools/java to the java binary, whatever the tarball's layout
# (macOS: jdk/Contents/Home/bin/java; Linux: jdk/bin/java). Everything else uses .tools/java.
JDK_VERSION=25.0.4.1+1
JDK_URL_DARWIN_ARM64=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jdk_aarch64_mac_hotspot_25.0.4.1_1.tar.gz
JDK_SHA256_DARWIN_ARM64=61979887f7506a24a57439ff99adb8b3a7fc89977d9cfe3b8984f58a981b7b9d
JDK_URL_DARWIN_X86_64=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jdk_x64_mac_hotspot_25.0.4.1_1.tar.gz
JDK_SHA256_DARWIN_X86_64=e6229d9504f7922053ab31821b9e6bee8761daf7b026a3476d1a027563009880
JDK_URL_LINUX_X86_64=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jdk_x64_linux_hotspot_25.0.4.1_1.tar.gz
JDK_SHA256_LINUX_X86_64=dbb698396d478e7fa2b1e50f4103324b2a99b90569ee27c33f2261f9215cf41e
JDK_URL_LINUX_AARCH64=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jdk_aarch64_linux_hotspot_25.0.4.1_1.tar.gz
JDK_SHA256_LINUX_AARCH64=69df11a02cfa3ef7d7ca645e03edce6778ec090e100f6ae2b42097865730ac52

# Node runs the synthesis pipeline (ABC only works in the npm build of YoWASP Yosys), the
# playground checks and the live backend. package.json's `engines.node` must agree.
NODE_MAJOR=26

# Verilator is the reference simulator every function check compares against. It comes from
# the system package manager, so setup.sh cannot choose the version; ./check asserts it.
VERILATOR_VERSION=5.052

# Yosys 0.68 compiled to WebAssembly. The same release is used natively (PyPI) and in the browser (npm).
# The versions are also pinned in pyproject.toml and package.json; `./check` asserts they agree.
YOWASP_PYPI=0.68.0.0.post1208
YOWASP_NPM=0.68.1207
